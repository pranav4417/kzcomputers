generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("agent")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  // Agent assignments
  tickets   Ticket[] @relation("AgentAssignment")

  @@map("admins")
}

model Customer {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  phone         String
  password      String
  verified      Boolean         @default(false)
  createdAt     DateTime        @default(now()) @map("created_at")
  quoteRequests QuoteRequest[]

  @@map("customers")
}

model Ticket {
  id           Int      @id @default(autoincrement())
  ticketNumber String   @unique @map("ticket_number")
  product      String
  serviceType  String   @map("service_type")
  customerName String   @map("customer_name")
  phone        String
  email        String
  subject      String
  description  String?
  image        String?
  priority     String   @default("Low")
  status       String   @default("Open")
  comments     String?
  ticketToken  String?  @unique @map("ticket_token")
  items        String?  // Store saved service/parts items as JSON
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Shopkeeper Additions
  assignedToId Int?     @map("assigned_to_id")
  assignedTo   Admin?   @relation("AgentAssignment", fields: [assignedToId], references: [id], onDelete: SetNull)

  updates      TicketUpdate[]
  invoices     Invoice[]
  quotes       QuoteRequest[] @relation("TicketQuotes")

  @@map("tickets")
}

model TicketUpdate {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  status      String
  comment     String?
  createdBy   String   // "Agent" or "System" or "Customer"
  createdAt   DateTime @default(now()) @map("created_at")

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_updates")
}

model Invoice {
  id           Int       @id @default(autoincrement())
  invoiceNumber String   @unique @map("invoice_number")
  ticketId     Int       @map("ticket_id")
  amount       Float
  status       String    @default("Unpaid")
  pdfUrl       String?   @map("pdf_url")
  items        String?   // JSON string for line items
  generatedBy  String?   @map("generated_by")
  excludingGst Boolean   @default(false) @map("excluding_gst")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ticket       Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal?
  category      String?        @default("General")
  image         String?
  stock         Int            @default(0)
  featured      Boolean        @default(false) @map("featured")
  displayOrder  Int            @default(0) @map("display_order")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  quoteRequests QuoteRequest[]

  @@map("products")
}

model QuoteRequest {
  id          Int      @id @default(autoincrement())
  customerId  Int?     @map("customer_id")
  productId   Int?     @map("product_id")
  ticketId    Int?     @map("ticket_id")
  guestEmail  String?  @map("guest_email")
  guestPhone  String?  @map("guest_phone")
  customerName String? @map("customer_name")
  message     String?
  items       String?  // JSON string for quote line items
  amount      Float?   @default(0)
  status      String   @default("Pending") // Pending, Sent, Accepted, Rejected
  quoteToken  String?  @map("quote_token")
  sentAt      DateTime? @map("sent_at")
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime @default(now()) @map("created_at")

  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  ticket      Ticket?   @relation("TicketQuotes", fields: [ticketId], references: [id], onDelete: SetNull)

  @@map("quote_requests")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  image       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("services")
}

model Slider {
  id        Int      @id @default(autoincrement())
  image     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sliders")
}

model Appearance {
  id             Int      @id @default(autoincrement())
  primaryColor   String   @default("#003B73") @map("primary_color")
  secondaryColor String   @default("#6C757D") @map("secondary_color")
  fontFamily     String   @default("Inter, sans-serif") @map("font_family")
  darkMode       Boolean  @default(true) @map("dark_mode")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("appearance")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otps")
}

model PendingUpdate {
  id          Int      @id @default(autoincrement())
  entityType  String
  entityId    Int?
  data        String
  submittedBy Int
  status      String   @default("Pending")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pending_updates")
}

// Group Service Module - Parts and Charges
model Part {
  id          Int      @id @default(autoincrement())
  name        String
  partNumber  String?  @unique @map("part_number")
  category    String   @default("General")
  description String?
  price       Float
  costPrice   Float?   @map("cost_price")
  hsnCode     String?  @map("hsn_code")
  gstRate     Float    @default(18) @map("gst_rate")
  stock       Int      @default(0)
  minStock    Int      @default(0) @map("min_stock")
  unit        String   @default("NOS") // NOS, KG, MTR, LTR, etc.
  image       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("parts")
}

model ServiceCharge {
  id          Int      @id @default(autoincrement())
  name        String
  code        String?  @unique // Service code like "LAB-001", "VISIT-001"
  category    String   @default("Labor") // Labor, Visit, Diagnostic, etc.
  description String?
  price       Float
  gstRate     Float    @default(18) @map("gst_rate")
  duration    Int?     // Duration in minutes
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_charges")
}

model ServiceGroup {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  displayOrder Int    @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("service_groups")
}
